{
  "name": "pixel-tiktaktoe",
  "version": "1.0.0",
  "description": "Jogo da Velha Multiplayer Retrô e Pixelado em Português (PT-BR)",
  "main": "server/server.js",
  "type": "module",
  "scripts": {
    "dev:server": "node server/server.js",
    "dev:client": "vite",
    "dev": "concurrently -n \"server,client\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "build": "vite build",
    "start": "node server/server.js",
    "test": "vitest run"
  },
  "keywords": [
    "tic-tac-toe",
    "jogo-da-velha",
    "pixel-art",
    "multiplayer",
    "socketio",
    "retro"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
